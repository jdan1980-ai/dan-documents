# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ из console.anthropic.com
ANTHROPIC_API_KEY=
# Твой Telegram user id (узнать у @userinfobot) — для команды /grant
ADMIN_IDS=
# Модели (можно менять без правки кода)
MODEL_CHAT=claude-haiku-4-5-20251001
MODEL_SOS=claude-opus-5-5
MODEL_REPORT=claude-haiku-4-5-20251001
# Платный доступ: false = все пользуются бесплатно (режим разработки)
PAYWALL_ENABLED=false
TRIAL_DAYS=7
# Лимит сообщений пользователя в сутки (защита от расходов на API)
DAILY_MESSAGE_LIMIT=80
DEFAULT_TIMEZONE=Asia/Jerusalem
DB_PATH=mira.db
# Ссылка на оплату (Lemon Squeezy / Stripe), показывается после окончания триала
PAYMENT_LINK=
