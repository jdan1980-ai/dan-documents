# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# YouTube Data API v3 ключ из https://console.cloud.google.com/
# Шаги: создать проект -> Enable "YouTube Data API v3" -> Credentials -> + Create credentials -> API key
YOUTUBE_API_KEY=AIzaSy_замени_на_свой_ключ

# Путь к SQLite кешу (относительно корня проекта)
DB_PATH=data/cache.db

# TTL кеша в секундах (86400 = 24 часа)
CACHE_TTL=86400

# Локаль интерфейса: ru или en
UI_LOCALE=ru

# Лог-уровень: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
